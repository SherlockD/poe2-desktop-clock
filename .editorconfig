root = true

[*.cs]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
dotnet_style_qualification_for_field = false:suggestion
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0058.severity = warning

[*.{csproj,sln,props,targets}]
indent_style = space
indent_size = 2
