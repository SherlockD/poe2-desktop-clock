<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <ApplicationIcon>..\Poe2DesktopClock.Infrastructure.Windows\Assets\Poe2DesktopClock.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Poe2DesktopClock.Contracts\Poe2DesktopClock.Contracts.csproj" />
    <ProjectReference Include="..\Poe2DesktopClock.Domain\Poe2DesktopClock.Domain.csproj" />
    <ProjectReference Include="..\Poe2DesktopClock.Application\Poe2DesktopClock.Application.csproj" />
    <ProjectReference Include="..\Poe2DesktopClock.Infrastructure.Windows\Poe2DesktopClock.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\Poe2DesktopClock.Infrastructure.PoeApi\Poe2DesktopClock.Infrastructure.PoeApi.csproj" />
    <ProjectReference Include="..\Poe2DesktopClock.Composition\Poe2DesktopClock.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Poe2DesktopClock.Infrastructure.Windows\Assets\Poe2DesktopClock.png">
      <Link>Assets\Poe2DesktopClock.png</Link>
    </Resource>
  </ItemGroup>
</Project>
