<Window x:Class="Poe2DesktopClock.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Poe2DesktopClock.Desktop.Views"
        xmlns:viewModels="clr-namespace:Poe2DesktopClock.Desktop.ViewModels"
        Icon="Assets/Poe2DesktopClock.png"
        Title="PoE 2 — Wraeclast Ledger"
        Width="1180"
        Height="800"
        MinWidth="960"
        MinHeight="660"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PublicTabsViewModel}">
            <views:PublicTabsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InitialSetupViewModel}">
            <views:InitialSetupView />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavigationButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Border x:Name="SelectionMark"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Margin="0,5"
                                    Background="{StaticResource AccentBrush}"
                                    Opacity="0" />
                            <Border x:Name="Surface"
                                    Margin="8,0,0,0"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="1">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionMark" Property="Opacity" Value="1" />
                                <Setter TargetName="Surface" Property="Background" Value="#5A382817" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#6150392B" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#40271F15" />
                                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Rectangle Fill="{StaticResource StoneTextureBrush}" IsHitTestVisible="False" />

        <ContentControl Content="{Binding InitialSetup}"
                        Visibility="{Binding IsInitialSetupActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Visibility="{Binding IsApplicationReady, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="#765D39"
                    BorderThickness="0,0,1,0"
                    Padding="18,26,18,22">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="8,0,4,34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="44" Height="44" VerticalAlignment="Top">
                                <Border BorderBrush="#8A6C43" BorderThickness="1" Margin="7">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" CenterX="15" CenterY="15" />
                                    </Border.RenderTransform>
                                </Border>
                                <Ellipse Width="30" Height="30" Stroke="#4F3B23" StrokeThickness="1" />
                                <TextBlock Text="II"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Palatino Linotype"
                                           FontWeight="Bold"
                                           FontSize="17"
                                           Foreground="{StaticResource AccentBrightBrush}" />
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="WRAECLAST"
                                           Style="{StaticResource EyebrowTextStyle}"
                                           FontSize="9" />
                                <TextBlock Text="LEDGER"
                                           Margin="0,-2,0,0"
                                           FontFamily="Palatino Linotype"
                                           FontWeight="Bold"
                                           FontSize="23"
                                           Foreground="{StaticResource MainTextBrush}" />
                                <TextBlock Text="POE 2 DESKTOP CLOCK"
                                           Margin="0,-1,0,0"
                                           FontSize="8"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="4,0,4,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border VerticalAlignment="Center" Style="{StaticResource OrnamentRuleStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="ХРАНИЛИЩЕ"
                                       Margin="10,0"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <Border Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource OrnamentRuleStyle}" />
                        </Grid>

                        <ToggleButton Content="◇   Обзор богатства"
                                      Style="{StaticResource NavigationButtonStyle}"
                                      IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"
                                      Command="{Binding ShowDashboardCommand}" />
                        <ToggleButton Content="◇   Публичные вкладки"
                                      Margin="0,7,0,0"
                                      Style="{StaticResource NavigationButtonStyle}"
                                      IsChecked="{Binding IsPublicTabsSelected, Mode=OneWay}"
                                      Command="{Binding ShowPublicTabsCommand}" />
                        <ToggleButton Content="◇   Источники и настройка"
                                      Margin="0,7,0,0"
                                      Style="{StaticResource NavigationButtonStyle}"
                                      IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                      Command="{Binding ShowSettingsCommand}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Style="{StaticResource InsetPanelStyle}" Padding="13" Margin="4,0">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Ellipse DockPanel.Dock="Left"
                                             Width="7"
                                             Height="7"
                                             Margin="0,0,8,0"
                                             Fill="{StaticResource SuccessBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="СОСТОЯНИЕ ИГРЫ" Style="{StaticResource EyebrowTextStyle}" />
                                </DockPanel>
                                <Border Style="{StaticResource OrnamentRuleStyle}" Margin="0,10,0,9" />
                                <TextBlock Text="{Binding Dashboard.GameStatus}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Dashboard.SessionStatus}"
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="8,14,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ЧАСЫ"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Dashboard.DeviceStatus}"
                                       Margin="12,0,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Text="Локальное хранение  ·  без чтения памяти"
                                   Margin="8,18,8,0"
                                   Foreground="#756C5D"
                                   FontSize="10"
                                   TextAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
