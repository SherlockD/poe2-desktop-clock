<Window x:Class="Poe2DesktopClock.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Poe2DesktopClock.Desktop.Views"
        xmlns:viewModels="clr-namespace:Poe2DesktopClock.Desktop.ViewModels"
        Title="PoE 2 Desktop Clock"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <Style x:Key="NavigationButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#2D4C4A" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#242E3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17202D" Padding="18,24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PoE 2" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="DESKTOP CLOCK" FontWeight="SemiBold" FontSize="22" Margin="0,2,0,34" />

                    <ToggleButton Content="◷  Обзор"
                                  Style="{StaticResource NavigationButtonStyle}"
                                  IsChecked="{Binding IsDashboardSelected}"
                                  Command="{Binding ShowDashboardCommand}" />
                    <ToggleButton Content="⚙  Настройки"
                                  Margin="0,8,0,0"
                                  Style="{StaticResource NavigationButtonStyle}"
                                  IsChecked="{Binding IsSettingsSelected}"
                                  Command="{Binding ShowSettingsCommand}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#122A2C" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Состояние игры" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding GameStatus}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Данные хранятся локально" Margin="5,18,5,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
