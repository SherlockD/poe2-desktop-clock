<Window x:Class="Poe2DesktopClock.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Poe2DesktopClock.Desktop.Views"
        xmlns:viewModels="clr-namespace:Poe2DesktopClock.Desktop.ViewModels"
        Title="PoE 2 Clock Companion"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="640"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <Style x:Key="NavigationButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#2D4C4A" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#242E3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17202D" Padding="18,24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Border Background="#122B36" BorderBrush="#285666" BorderThickness="1" CornerRadius="11" Padding="13,12" Margin="0,0,0,30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="33" Height="33" Background="#0F766E" CornerRadius="9" VerticalAlignment="Top">
                                <TextBlock Text="◷" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="#E7FFF7" />
                            </Border>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="POE 2" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="CLOCK COMPANION" FontWeight="SemiBold" FontSize="17" Margin="0,1,0,0" />
                                <TextBlock Text="Помощник для физических часов" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="7,0,0,7" />
                    <ToggleButton Content="◫  Мониторинг"
                                  Style="{StaticResource NavigationButtonStyle}"
                                  IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"
                                  Command="{Binding ShowDashboardCommand}" />
                    <ToggleButton Content="⚙  Источники и настройки"
                                  Margin="0,8,0,0"
                                  Style="{StaticResource NavigationButtonStyle}"
                                  IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                  Command="{Binding ShowSettingsCommand}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#132B35" BorderBrush="#285666" BorderThickness="1" CornerRadius="9" Padding="12">
                        <StackPanel>
                            <TextBlock Text="СОСТОЯНИЕ ИГРЫ" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Dashboard.GameStatus}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="{Binding Dashboard.SessionStatus}" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="#1B273A" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="УСТРОЙСТВО" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Dashboard.DeviceStatus}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Данные хранятся локально"
                               Margin="5,18,5,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
