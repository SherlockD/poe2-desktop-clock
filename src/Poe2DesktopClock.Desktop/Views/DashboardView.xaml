<UserControl x:Class="Poe2DesktopClock.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0"
             MinHeight="0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="42,36,42,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Обзор" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Стоимость отслеживаемого инвентаря" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="15" />
                </StackPanel>
                <Button Content="Обновить данные"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2" Background="#0A111B" BorderBrush="#2C4650" BorderThickness="1" CornerRadius="22" Padding="36,30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="ВИРТУАЛЬНЫЕ ЧАСЫ" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold" />
                        <Border DockPanel.Dock="Right" Background="#173934" CornerRadius="10" Padding="10,4">
                            <TextBlock Text="{Binding EstimateQuality}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                        </Border>
                    </DockPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,18,0,14" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayTotal}" FontFamily="Consolas" FontWeight="Bold" FontSize="78" Foreground="#E7FFF7" />
                            <TextBlock Text=" div" FontFamily="Consolas" FontSize="30" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="14,0,0,10" />
                        </StackPanel>
                    </Viewbox>
                    <DockPanel Grid.Row="2">
                        <TextBlock Text="Обновляется при изменении Currency-вкладки" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrencyUpdatedAt}" Foreground="{StaticResource MainTextBrush}" FontFamily="Consolas" FontSize="13" />
                    </DockPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="4" Columns="3" HorizontalAlignment="Stretch">
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="12" Padding="17" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="CURRENCY-ВКЛАДКА" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrencyStatus}" Margin="0,8,0,7" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrencyUpdatedAt}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="12" Padding="17" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="ПУБЛИЧНЫЕ ВКЛАДКИ" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PublicStashStatus}" Margin="0,8,0,7" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PublicStashUpdatedAt}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="12" Padding="17" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ЦЕНЫ" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="poe.ninja" Margin="0,8,0,7" />
                        <TextBlock Text="{Binding PricesUpdatedAt}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
