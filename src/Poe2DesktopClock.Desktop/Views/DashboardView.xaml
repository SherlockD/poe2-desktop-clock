<UserControl x:Class="Poe2DesktopClock.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:Poe2DesktopClock.Desktop.Localization"
             MinWidth="0"
             MinHeight="0">
    <UserControl.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource PanelCardStyle}">
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EyebrowTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="GameStatusPlaqueStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#9C241A0E" />
            <Setter Property="BorderBrush" Value="#795A31" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                    <Setter Property="Background" Value="#9C172017" />
                    <Setter Property="BorderBrush" Value="#587049" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GameStatusDotStyle" TargetType="{x:Type Ellipse}">
            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SourceValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SourceMonogramStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="31" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Background" Value="#3E2C17" />
            <Setter Property="BorderBrush" Value="#8B6A3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <Grid Margin="38,31,38,38" MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="27" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="27" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <Border DockPanel.Dock="Right"
                        Style="{StaticResource GameStatusPlaqueStyle}"
                        Margin="18,5,0,0"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource GameStatusDotStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GameStatus}"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="{localization:Text Dashboard_Eyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{localization:Text Dashboard_Title}" Margin="0,2,0,0" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{localization:Text Dashboard_Subtitle}"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource HeroBackgroundBrush}"
                    BorderBrush="#927147"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="28,25">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{StaticResource StoneTextureBrush}" Margin="-28,-25" IsHitTestVisible="False" />
                    <Border Height="1" VerticalAlignment="Top" Margin="-2,-1,-2,0" Background="{StaticResource OrnamentLineBrush}" />
                    <Border Height="1" VerticalAlignment="Bottom" Margin="50,0,50,-1" Background="{StaticResource OrnamentLineBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.12*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,25,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="1,0,9,0" VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" CenterX="4" CenterY="4" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="{localization:Text Dashboard_TotalValue}" Style="{StaticResource MetricLabelStyle}" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayTotal}"
                                       Margin="0,8,0,0"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="54"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="430" />
                            <Border Style="{StaticResource OrnamentRuleStyle}" Margin="0,7,40,9" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{localization:Text Dashboard_SessionBaseline}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding SessionBaseline}"
                                           Margin="9,0,0,0"
                                           Foreground="{StaticResource MainTextBrush}"
                                           FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Grid.ColumnSpan="2" Background="#6A080705" BorderBrush="#4E3D29" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InsetPanelStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{localization:Text Dashboard_SessionState}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding SessionStatus}"
                                                   Margin="0,5,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource InsetPanelStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{localization:Text Dashboard_Duration}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding SessionDuration}" Margin="0,4,0,0" Style="{StaticResource MetricValueStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InsetPanelStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{localization:Text Dashboard_Change}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding SessionDelta}" Margin="0,4,0,0" Style="{StaticResource MetricValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2"
                                        Background="#6E382713"
                                        BorderBrush="#856636"
                                        BorderThickness="1"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{localization:Text Dashboard_Rate}" Style="{StaticResource MetricLabelStyle}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding DivinesPerHour}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource AccentBrightBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="13" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{localization:Text Dashboard_SourcesCaption}"
                               VerticalAlignment="Bottom"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" />
                    <TextBlock Text="{localization:Text Dashboard_SourcesTitle}" Style="{StaticResource SectionTitleStyle}" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource SourceMonogramStyle}">
                                    <TextBlock Text="{localization:Text Dashboard_CurrencyMonogram}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Palatino Linotype" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{localization:Text Dashboard_CurrencyTab}" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding CurrencyTotal}" Style="{StaticResource SourceValueStyle}" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding CurrencyStatus}"
                                       Margin="0,9,0,14"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <Border Grid.Row="3" BorderBrush="#463825" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrencyUpdatedAt}" Foreground="{StaticResource AccentBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="12" />
                                    <TextBlock Text="{localization:Text Common_Updated}" Style="{StaticResource MetricLabelStyle}" FontSize="9" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource SourceMonogramStyle}">
                                    <TextBlock Text="{localization:Text Dashboard_PublicTabsMonogram}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Palatino Linotype" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{localization:Text Dashboard_PublicStashTabs}" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding PublicTabsTotal}" Style="{StaticResource SourceValueStyle}" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding PublicStashStatus}"
                                       Margin="0,9,0,14"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <Border Grid.Row="3" BorderBrush="#463825" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PublicStashUpdatedAt}" Foreground="{StaticResource AccentBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="12" />
                                    <TextBlock Text="{localization:Text Common_Updated}" Style="{StaticResource MetricLabelStyle}" FontSize="9" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource SourceMonogramStyle}">
                                    <TextBlock Text="{localization:Text Dashboard_PricesMonogram}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Palatino Linotype" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{localization:Text Dashboard_MarketPrices}" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{localization:Text Dashboard_PriceSource}" Style="{StaticResource SourceValueStyle}" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="{localization:Text Dashboard_MarketPricesDescription}"
                                       Margin="0,9,0,14"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <Border Grid.Row="3" BorderBrush="#463825" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PricesUpdatedAt}" Foreground="{StaticResource AccentBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="12" />
                                    <TextBlock Text="{localization:Text Common_Updated}" Style="{StaticResource MetricLabelStyle}" FontSize="9" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="13" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{localization:Text Dashboard_DeviceSection}" Style="{StaticResource SectionTitleStyle}" />

                <Border Grid.Row="2" Style="{StaticResource DashboardCardStyle}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{localization:Text Dashboard_ClockEmulator}" Margin="8,0,0,0" Style="{StaticResource MetricLabelStyle}" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DeviceStatus}" Margin="0,7,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{localization:Text Dashboard_DeviceRoadmap}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="#554B3C28" />

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{localization:Text Dashboard_LastValue}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding DeviceDisplayTotal}" Margin="0,4,0,0" Style="{StaticResource MetricValueStyle}" Foreground="{StaticResource AccentBrightBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                            <TextBlock Text="{localization:Text Dashboard_SynchronizedAt}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding DeviceLastSynchronizedAt}"
                                       Margin="0,5,0,0"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="14"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
