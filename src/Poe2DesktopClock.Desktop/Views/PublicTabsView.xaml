<UserControl x:Class="Poe2DesktopClock.Desktop.Views.PublicTabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:Poe2DesktopClock.Desktop.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PublicTabCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource PanelCardStyle}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EyebrowTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="38,31,38,38" MaxWidth="1180">
            <TextBlock Text="{localization:Text PublicTabs_Eyebrow}" Style="{StaticResource EyebrowTextStyle}" />
            <TextBlock Text="{localization:Text PublicTabs_Title}" Margin="0,2,0,0" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{localization:Text PublicTabs_Subtitle}"
                       Margin="0,5,0,20"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14" />

            <Border Style="{StaticResource PanelCardStyle}" Padding="22,19" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{localization:Text PublicTabs_Total}" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding TotalDivines}"
                                   Margin="0,5,0,0"
                                   FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrightBrush}" />
                        <TextBlock Text="{Binding Summary}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#554B3C28" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{localization:Text Common_Updated}" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding UpdatedAt}"
                                   Margin="0,5,0,0"
                                   FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#7D382713"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    Padding="14,11"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasTradeApiLimitWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{localization:Text Common_WarningMark}"
                               Margin="0,0,11,0"
                               FontFamily="Palatino Linotype"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="{Binding LimitWarningSummary}"
                               Foreground="{StaticResource MainTextBrush}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <TextBlock Text="{localization:Text PublicTabs_Section}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />

            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PublicTabCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TabName}"
                                               Margin="0,3,0,0"
                                               FontFamily="Bahnschrift SemiCondensed"
                                               FontSize="13"
                                               Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{localization:Text PublicTabs_TabValue}" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Divines}"
                                               Margin="0,3,0,0"
                                               FontFamily="Bahnschrift SemiCondensed"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrightBrush}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,13,0,0">
                                    <Border Style="{StaticResource InsetPanelStyle}" Padding="9,6" Margin="0,0,7,0">
                                        <TextBlock Text="{Binding ItemSummary}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                    <Border Padding="9,6">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource InsetPanelStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUnpricedItemWarning}" Value="True">
                                                        <Setter Property="Background" Value="#7D382713" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PriceSummary}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                </WrapPanel>

                                <Border Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,12,0,0"
                                        Padding="11,8">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="#3A2A2117" />
                                            <Setter Property="BorderBrush" Value="#5A493326" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTradeApiLimitWarning}" Value="True">
                                                    <Setter Property="Background" Value="#7D382713" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusSummary}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MainTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Padding="15,12" Margin="0,4,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource InsetPanelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTabs}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding EmptyMessage}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
