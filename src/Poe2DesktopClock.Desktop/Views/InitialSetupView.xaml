<UserControl x:Class="Poe2DesktopClock.Desktop.Views.InitialSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:Poe2DesktopClock.Desktop.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <Grid Margin="48,34,48,44" HorizontalAlignment="Center" MaxWidth="920">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{localization:Text InitialSetup_Eyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Text="{localization:Text InitialSetup_Title}" Margin="0,2,0,0" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{localization:Text InitialSetup_Subtitle}"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{localization:Text InitialSetup_CurrencyStepLabel}" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{localization:Text InitialSetup_CurrencyStepTitle}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrencyStepState}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{localization:Text InitialSetup_PublicTabsStepLabel}" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{localization:Text InitialSetup_PublicTabsStepTitle}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding PublicTabsStepState}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource PanelCardStyle}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{localization:Text InitialSetup_DeviceStepLabel}" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{localization:Text InitialSetup_DeviceStepTitle}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DeviceStepState}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource PanelCardStyle}" Padding="28">
                <Grid>
                    <Grid Visibility="{Binding IsCurrencyStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{localization:Text InitialSetup_CurrencyStepTitle}" Style="{StaticResource SectionTitleStyle}" FontSize="22" />
                            <TextBlock Text="{localization:Text InitialSetup_CurrencyDescription}"
                                       Margin="0,8,0,22"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />

                            <Border Style="{StaticResource InsetPanelStyle}" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{localization:Text InitialSetup_SelectRegionStep}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrencyAreaStatus}" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{localization:Text InitialSetup_SelectRegionButton}" Command="{Binding SelectCurrencyAreaCommand}" VerticalAlignment="Center" Margin="18,0,0,0" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource InsetPanelStyle}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{localization:Text InitialSetup_ConfigureSlotsStep}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrencySlotsStatus}" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{localization:Text InitialSetup_ConfigureSlotsButton}" Command="{Binding CalibrateCurrencyCommand}" VerticalAlignment="Center" Margin="18,0,0,0" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding Notice}" Margin="0,18,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            <WrapPanel HorizontalAlignment="Right" Margin="0,25,0,0">
                                <Button Content="{localization:Text InitialSetup_Next}" Command="{Binding CurrencyNextCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsPublicTabsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{localization:Text InitialSetup_PublicTabsTitle}" Style="{StaticResource SectionTitleStyle}" FontSize="22" />
                            <TextBlock Text="{localization:Text InitialSetup_PublicTabsDescription}"
                                       Margin="0,8,0,20"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{localization:Text InitialSetup_AccountName}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsNotSynchronizing}"
                                             ToolTip="{localization:Text InitialSetup_AccountExample}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{localization:Text InitialSetup_League}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="{localization:Text InitialSetup_Refresh}" Command="{Binding RefreshLeaguesCommand}" IsEnabled="{Binding IsNotSynchronizing}" Margin="10,0,0,0" />
                                        <ComboBox ItemsSource="{Binding Leagues}" SelectedItem="{Binding SelectedLeague}" IsEnabled="{Binding IsNotSynchronizing}" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{localization:Text InitialSetup_MarkerDescription}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding PublicTabs}" IsEnabled="{Binding IsNotSynchronizing}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetPanelStyle}" Padding="12" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="185" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding RequiredName}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" TextAlignment="Right" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding PublicTabsSummary}" Margin="0,16,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Notice}" Margin="0,8,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
                                <Button Content="{localization:Text InitialSetup_Back}" Command="{Binding PublicTabsBackCommand}" Margin="0,0,10,0" />
                                <Button Content="{localization:Text InitialSetup_Synchronize}" Command="{Binding SynchronizePublicTabsCommand}" Margin="0,0,10,0" />
                                <Button Content="{localization:Text InitialSetup_Cancel}" Command="{Binding CancelSynchronizationCommand}" IsEnabled="{Binding IsSynchronizing}" Margin="0,0,10,0" />
                                <Button Content="{localization:Text InitialSetup_Next}" Command="{Binding PublicTabsNextCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsDeviceStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{localization:Text InitialSetup_DeviceStepTitle}" Style="{StaticResource SectionTitleStyle}" FontSize="22" />
                            <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,22,0,10">
                                <Ellipse Stroke="{StaticResource AccentDarkBrush}" StrokeThickness="1" />
                                <Border Width="34" Height="34" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" CenterX="17" CenterY="17" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="{localization:Text Brand_Emblem}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Palatino Linotype" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" />
                            </Grid>
                            <TextBlock Text="{localization:Text InitialSetup_DeviceDescription}"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,22" />
                            <Border Style="{StaticResource InsetPanelStyle}" Padding="16">
                                <TextBlock Text="{Binding DeviceSummary}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding Notice}" Margin="0,18,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            <WrapPanel HorizontalAlignment="Right" Margin="0,25,0,0">
                                <Button Content="{localization:Text InitialSetup_Back}" Command="{Binding DeviceBackCommand}" Margin="0,0,10,0" />
                                <Button Content="{localization:Text InitialSetup_Finish}" Command="{Binding FinishCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
