<Application x:Class="Poe2DesktopClock.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <Color x:Key="WindowBackgroundColor">#11161F</Color>
        <Color x:Key="PanelBackgroundColor">#1B2330</Color>
        <Color x:Key="RaisedPanelColor">#242E3D</Color>
        <Color x:Key="AccentColor">#66E0B6</Color>
        <Color x:Key="MutedTextColor">#9AA8BC</Color>
        <Color x:Key="MainTextColor">#F1F5FA</Color>
        <Color x:Key="WarningColor">#F7C66C</Color>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
        <SolidColorBrush x:Key="RaisedPanelBrush" Color="{StaticResource RaisedPanelColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
        <SolidColorBrush x:Key="MainTextBrush" Color="{StaticResource MainTextColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

        <Style TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource RaisedPanelBrush}" />
            <Setter Property="BorderBrush" Value="#3A4A61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#304158" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#217C68" />
            <Setter Property="BorderBrush" Value="#66E0B6" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="Background" Value="#121923" />
            <Setter Property="BorderBrush" Value="#3A4A61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="Background" Value="#121923" />
            <Setter Property="BorderBrush" Value="#3A4A61" />
            <Setter Property="Padding" Value="5" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Application.Resources>
</Application>
